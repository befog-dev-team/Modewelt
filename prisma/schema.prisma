generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                   @id @default(cuid())
  username               String                   @unique
  displayName            String
  email                  String?                  @unique
  location               String?
  phone                  String?
  passwordHash           String?
  googleId               String?                  @unique
  backgroundImageUrl     String?
  avatarUrl              String?
  bio                    String?
  profileHeadline        String?
  profileHeadlineLink    String?
  totalProfileViews      Int                      @default(0)
  totalLikes             Int                      @default(0)
  totalComments          Int                      @default(0)
  totalPosts             Int                      @default(0)
  totalFollowers         Int                      @default(0)
  totalFollowing         Int                      @default(0)
  totalShares            Int                      @default(0)
  totalSearchAppearances Int                      @default(0)
  isVerified             Boolean                  @default(false)
  isBanned               Boolean                  @default(false)
  isDeleted              Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  lastLogin              DateTime?
  role                   Role                     @default(USER)
  emailTokens            EmailVerificationToken[]
  endorsements           Endorsement[]
  jobs                   Job[]
  jobApplications        JobApplication[]
  AdminActivity          AdminActivity[]
  commentLikes           CommentLike[]
  comments               Comment[]
  educations             Education[]
  experiences            Experience[]
  receiverRequest        FollowerRequest[]        @relation("ReceiverRequests")
  senderRequest          FollowerRequest[]        @relation("SenderRequests")
  following              Follow[]                 @relation("Following")
  followers              Follow[]                 @relation("Followers")
  likes                  Like[]
  issuedNotifications    Notification[]           @relation("Issuer")
  receivedNotifications  Notification[]           @relation("Recipient")
  posts                  Post[]
  profileViewedUser      ProfileView[]            @relation("ProfileViewedUser")
  profileViewerView      ProfileView[]            @relation("ProfileViewerView")
  projects               Project[]
  Report                 Report[]
  Session                Session[]
  skills                 Skill[]

  @@map("users")
}

model AdminActivity {
  id     String   @id @default(cuid())
  userId String
  action String
  date   DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_activities")
}

model AdminStats {
  id           String   @id @default(cuid())
  totalActions Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id                  String         @id @default(cuid())
  content             String
  userId              String
  createdAt           DateTime       @default(now())
  comments            Comment[]
  likes               Like[]
  linkedNotifications Notification[]
  attachments         Media[]
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  Report              Report[]

  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  projectId String?
  fileName  String
  fileSize  Int
  type      MediaType
  url       String
  public_id String
  createdAt DateTime  @default(now())
  reportId  String?
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Report    Report?   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("post_media")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  userId    String
  postId    String
  parentId  String?
  createdAt DateTime      @default(now())
  likes     CommentLike[]
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_likes")
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  followingId String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model FollowerRequest {
  id         String        @id @default(cuid())
  senderId   String
  receiverId String
  status     RequestStatus
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  receiver   User          @relation("ReceiverRequests", fields: [receiverId], references: [id])
  sender     User          @relation("SenderRequests", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
  @@map("follower_requests")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  issuerId    String
  postId      String?
  type        NotificationType
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  viewedId  String
  createdAt DateTime @default(now())
  viewed    User     @relation("ProfileViewedUser", fields: [viewedId], references: [id], onDelete: Cascade)
  viewer    User     @relation("ProfileViewerView", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([viewerId, viewedId])
  @@map("profile_views")
}

model Job {
  id             String           @id @default(cuid())
  jobTitle       String
  company        String
  companyPic     String?
  workplaceType  String
  location       String
  jobType        String
  description    String
  requirements   String
  benefits       String
  skills         String[]
  salaryCountry  String
  salaryCurrency String
  salaryAmount   String
  salaryType     String
  jobLevel       String
  expirationDate String
  createdAt      DateTime         @default(now())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   JobApplication[]
  Report         Report[]
}

model JobApplication {
  id                  String   @id @default(cuid())
  resumeFileUrl       String?
  resumeFileName      String?
  resumeFileSize      Int?
  additionalDocuments Json?
  firstName           String
  middleName          String?
  lastName            String
  gender              String
  email               String
  countryCode         String
  phone               String
  dob                 DateTime
  currentSalary       String?
  expectedSalary      String?
  preferredLocation   String?
  availableJoinDays   String
  currentLocation     String
  achievements        String?
  portfolioUrl        String?
  notes               String?
  language            String?
  skills              String?
  agreedToPolicy      Boolean? @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  experienceList      Json?
  educationList       Json?
  jobId               String
  userId              String
  job                 Job      @relation(fields: [jobId], references: [id])
  user                User     @relation(fields: [userId], references: [id])
}

model Report {
  id           String   @id @default(cuid())
  reason       String
  customReason String?
  email        String
  altEmail     String?
  postId       String?
  jobId        String?
  createdAt    DateTime @default(now())
  userId       String
  media        Media[]
  job          Job?     @relation(fields: [jobId], references: [id])
  post         Post?    @relation(fields: [postId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  media       Media[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Education {
  id             String   @id @default(cuid())
  userId         String
  institution    String
  degree         String
  duration       String
  additionalInfo String?
  imageUrl       String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model Experience {
  id          String   @id @default(cuid())
  userId      String
  jobTitle    String
  company     String
  location    String
  duration    String
  description String?
  publicId    String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

model Skill {
  id               String        @id @default(cuid())
  userId           String
  title            String
  endorsements     Int           @default(0)
  createdAt        DateTime      @default(now())
  endorsementsList Endorsement[]
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Endorsement {
  id        String   @id @default(cuid())
  skillId   String
  userId    String
  createdAt DateTime @default(now())
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([skillId, userId])
}

enum Role {
  USER
  ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
  AUDIO
  OTHER
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW_REQUESTED
  FOLLOW_ACCEPTED
  PROFILE_VIEW
}
