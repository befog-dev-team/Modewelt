{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "react",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
, "src/app/(main)/jobform/[id]/jobApplication.js", "src/app/api/projects/route.js", "src/app/api/education/route.js", "src/app/api/experience/route.js", "src/app/api/skills/route.js", "src/app/api/skills/[username]/[skillId]/route.js", "src/app/api/skills/endorse/route.js", "src/app/api/job-search/route.js", "src/components/Jobs/NewJobSection/job-search/JobSearchResults.jsx", "src/app/ui/calendar.jsx", "src/app/ui/calendar.jsx", "src/components/Feed/Post/ReportModal.jsx", "src/components/Feed/Post/index.jsx", "src/app/ui/dashboard/content/Job.jsx", "src/components/ToolBar.jsx", "src/components/Jobs/JobSection/deleteJobMutation.js", "src/components/Jobs/JobSection/DeleteJobDialog.jsx"  ],
  "exclude": [
    "node_modules"
  ]
}
